digraph G {
  graph [bgcolor="white", pad="0.08", nodesep="0.28", ranksep="0.34"];
  node [shape=box, style="rounded,filled", fillcolor=white, color=black, fontname="Helvetica", fontsize=10, margin="0.10,0.06"];
  edge [color=black, arrowsize=0.7, fontname="Helvetica", fontsize=8];

  src [label="Mail sources\n(JSON import / .eml file)"];
  cls [label="Sample Classroom status\n(synthetic fixture)"];
  imp [label="Import and validation layer\n(atomic batch, dedup, size limits)"];
  ext [label="Role 1: EvidenceExtractor\nproposes deadline + verbatim\nsource quote", style="rounded,filled,bold", fillcolor=white];
  llm [label="Optional model adapter\n(OpenAI-compatible endpoint,\nquote-checked)", style="rounded,dashed,filled"];
  gate [label="Human review gate\n(no auto-approval)"];
  db [label="Task store (SQLite)\nmails, tasks, drafts, reminders, audit log"];
  plan [label="Role 2: ActionPlanner\nstate labels + faculty-reply drafts\n(no send capability)", style="rounded,filled,bold"];
  rem [label="Reminder worker\n(24 h / 1 h / overdue bands,\n15 s tick, emitted once each)"];
  o1 [label="In-app\nreminders"];
  o2 [label=".ics calendar export\n(approved deadlines only)"];
  o3 [label="Draft reply\n(copy only, no Send)"];

  src -> imp; cls -> imp;
  imp -> ext;
  llm -> ext [style=dashed, label="suggestion only"];
  ext -> gate;
  gate -> db;
  db -> plan; db -> rem;
  plan -> o3; rem -> o1; db -> o2;
  ext -> llm [style=dashed, dir=back, label="rejected unless\nquote is verbatim"];
  { rank=same; ext; llm; }
  { rank=same; o1; o2; o3; }
}
