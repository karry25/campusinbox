digraph G {
  graph [bgcolor="white", pad="0.08", nodesep="0.26", ranksep="0.30"];
  node [shape=box, style="rounded,filled", fillcolor=white, color=black, fontname="Helvetica", fontsize=9, margin="0.09,0.05"];
  edge [color=black, arrowsize=0.65, fontname="Helvetica", fontsize=7.5];
  a [label="Mail imported"];
  b [label="Needs review\n(date + verbatim quote shown)"];
  c [label="Approved by user (Upcoming)"];
  d [label="Overdue -\nsubmission unverified"];
  e [label="Missing\n(sample Classroom\nevidence)"];
  f [label="Submitted\n(reported / fixture)"];
  g [label="Revision import: version +1,\nback to Needs review,\nold reminders dropped", shape=note, style="filled"];
  a -> b [label="extract"];
  b -> c [label="approve"];
  c -> d [label="clock passes\ndue time"];
  d -> e [label="synthetic status\nNOT_SUBMITTED"];
  e -> f [label="TURNED_IN"];
  d -> g [dir=none, style=dotted];
  g -> b [style=dashed, label="new mail, same key"];
  { rank=same; d; e; }
}
